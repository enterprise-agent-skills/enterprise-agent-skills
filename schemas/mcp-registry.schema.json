{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "mcp-registry.schema.json",
  "title": "Curated MCP server registry (mcp/servers.yaml)",
  "type": "object",
  "required": ["servers"],
  "additionalProperties": false,
  "properties": {
    "servers": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "name", "vendor", "publisher", "official", "source", "license", "transport", "auth", "bundle_policy", "last_verified", "description"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" },
          "name": { "type": "string" },
          "vendor": { "type": "string" },
          "publisher": { "type": "string" },
          "official": { "type": "boolean", "description": "True only when the product vendor publishes and maintains the server." },
          "source": { "type": "string", "pattern": "^https://" },
          "license": { "type": "string" },
          "description": { "type": "string", "minLength": 20 },
          "transport": { "enum": ["stdio", "streamable-http"] },
          "command": { "type": "string", "pattern": "^[A-Za-z0-9._-]+$" },
          "args": { "type": "array", "items": { "type": "string" } },
          "url": { "type": "string", "pattern": "^https://" },
          "auth": {
            "enum": ["none", "user-login", "api-credentials"],
            "description": "none: no credentials; user-login: interactive sign-in handled by the server or CLI; api-credentials: needs keys or system credentials supplied by the user."
          },
          "read_only_by_default": { "type": "boolean" },
          "bundle_policy": {
            "enum": ["bundle", "document-only"],
            "description": "bundle: may be included in a plugin's generated MCP config. document-only: listed in docs with setup steps, never auto-installed."
          },
          "requirements": { "type": "string" },
          "last_verified": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" }
        },
        "allOf": [
          {
            "if": { "properties": { "transport": { "const": "stdio" } } },
            "then": { "required": ["command", "args"] }
          },
          {
            "if": { "properties": { "transport": { "const": "streamable-http" } } },
            "then": { "required": ["url"] }
          },
          {
            "if": { "properties": { "bundle_policy": { "const": "bundle" } } },
            "then": { "properties": { "auth": { "const": "none" }, "official": { "const": true } } }
          }
        ]
      }
    }
  }
}
