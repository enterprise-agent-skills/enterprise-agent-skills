{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "mcp-registry.schema.json",
  "title": "Curated MCP server registry (mcp/servers.yaml)",
  "type": "object",
  "required": ["servers"],
  "additionalProperties": false,
  "properties": {
    "servers": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "name", "vendor", "publisher", "official", "source", "license", "transport", "auth", "bundle_policy", "last_verified", "description"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" },
          "name": { "type": "string" },
          "vendor": { "type": "string" },
          "publisher": { "type": "string" },
          "official": { "type": "boolean", "description": "True only when the product vendor publishes and maintains the server. Always false for a server published from this repository." },
          "source": { "type": "string", "pattern": "^https://" },
          "license": { "type": "string" },
          "description": { "type": "string", "minLength": 20 },
          "transport": { "enum": ["stdio", "streamable-http"] },
          "command": { "type": "string", "pattern": "^[A-Za-z0-9._-]+$" },
          "args": { "type": "array", "items": { "type": "string" } },
          "url": { "type": "string", "pattern": "^https://" },
          "auth": {
            "enum": ["none", "user-login", "api-credentials", "system-credentials"],
            "description": "none: no credentials; user-login: interactive sign-in handled by the server or CLI; api-credentials: needs keys or system credentials supplied by the user; system-credentials: credentials for the user's own system, prompted by the agent or written by the server's setup command, never stored in the repository."
          },
          "read_only_by_default": { "type": "boolean" },
          "bundle_policy": {
            "enum": ["bundle", "document-only"],
            "description": "bundle: may be included in a plugin's generated MCP config. document-only: listed in docs with setup steps, never auto-installed."
          },
          "requirements": { "type": "string" },
          "last_verified": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
          "bundled_from_plugin": {
            "type": "string",
            "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
            "description": "Name of the plugin under plugins/ whose folder holds the server's code. The server is published from this repository: official is false, it is read-only by default, only that plugin may bundle it, and it is reviewed like a bundled script."
          },
          "plugin_path": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]+(\\.[A-Za-z0-9_-]+)*(/[A-Za-z0-9_-]+(\\.[A-Za-z0-9_-]+)*)*$",
            "description": "Path of the launcher inside the plugin folder, with forward slashes and no '..', for example mcp/sap-system/launch.mjs. Each generated platform config prefixes its own plugin-root variable."
          },
          "plugin_args": {
            "type": "array",
            "items": { "type": "string" },
            "description": "Arguments passed after the launcher path when an agent starts the server."
          },
          "setup_args": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string" },
            "description": "Arguments of the one-time setup command (node <plugin folder>/<plugin_path> <setup_args>) for agents that do not prompt for the connection details."
          },
          "setup_notes": {
            "type": "string",
            "description": "What the setup command does and where it writes the connection details. Shown in the plugin README."
          },
          "data_access": {
            "type": "string",
            "minLength": 40,
            "description": "Which hosts the server talks to, which credentials it uses, and what read-only by default means for it. Shown in the plugin README."
          },
          "user_config": {
            "type": "object",
            "minProperties": 1,
            "propertyNames": { "pattern": "^[a-z][a-z0-9_]*$" },
            "description": "Connection details the agent asks the user for. Claude Code: userConfig in .claude-plugin/plugin.json plus ${user_config.KEY} in the env of .mcp.json. Gemini CLI: the settings array of gemini-extension.json. Agent Plugins hosts get no env; users run the setup command.",
            "additionalProperties": {
              "type": "object",
              "required": ["title", "description", "type", "env"],
              "additionalProperties": false,
              "properties": {
                "title": { "type": "string", "minLength": 1 },
                "description": { "type": "string", "minLength": 1 },
                "type": { "enum": ["string", "number", "boolean"] },
                "required": { "type": "boolean" },
                "default": { "type": ["string", "number", "boolean"] },
                "sensitive": { "type": "boolean", "description": "True for passwords and tokens: the agent masks the input and stores the value in its secure credential store." },
                "env": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]*$", "description": "Environment variable the server reads the value from." }
              }
            }
          }
        },
        "dependentRequired": {
          "setup_notes": ["setup_args"]
        },
        "allOf": [
          {
            "if": { "properties": { "transport": { "const": "stdio" } }, "required": ["transport"] },
            "then": { "required": ["command"] }
          },
          {
            "if": { "properties": { "transport": { "const": "stdio" } }, "required": ["transport"], "not": { "required": ["bundled_from_plugin"] } },
            "then": { "required": ["args"] }
          },
          {
            "if": { "properties": { "transport": { "const": "streamable-http" } }, "required": ["transport"] },
            "then": { "required": ["url"] }
          },
          {
            "if": { "properties": { "bundle_policy": { "const": "bundle" } }, "required": ["bundle_policy"], "not": { "required": ["bundled_from_plugin"] } },
            "then": { "properties": { "auth": { "const": "none" }, "official": { "const": true } } }
          },
          {
            "if": { "required": ["bundled_from_plugin"] },
            "then": {
              "required": ["plugin_path", "plugin_args", "data_access", "read_only_by_default"],
              "properties": {
                "official": { "const": false },
                "transport": { "const": "stdio" },
                "bundle_policy": { "const": "bundle" },
                "auth": { "enum": ["none", "system-credentials"] },
                "read_only_by_default": { "const": true }
              }
            },
            "else": {
              "not": {
                "anyOf": [
                  { "required": ["plugin_path"] },
                  { "required": ["plugin_args"] },
                  { "required": ["setup_args"] },
                  { "required": ["setup_notes"] },
                  { "required": ["data_access"] },
                  { "required": ["user_config"] }
                ]
              }
            }
          }
        ]
      }
    }
  }
}
