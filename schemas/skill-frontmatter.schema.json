{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "skill-frontmatter.schema.json",
  "title": "SKILL.md frontmatter",
  "description": "Agent Skills specification fields (agentskills.io) plus this repository's required metadata keys. Only spec fields are allowed at the top level so skills stay portable across agents.",
  "type": "object",
  "required": ["name", "description", "license", "compatibility", "metadata"],
  "additionalProperties": false,
  "properties": {
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
    },
    "description": {
      "type": "string",
      "minLength": 150,
      "maxLength": 1024
    },
    "license": { "type": "string", "minLength": 1 },
    "compatibility": {
      "type": "string",
      "minLength": 20,
      "maxLength": 500,
      "description": "Prerequisites: products, releases, tools and access the skill assumes."
    },
    "allowed-tools": { "type": "string" },
    "metadata": {
      "type": "object",
      "required": ["vendor", "product", "category", "maturity", "version"],
      "additionalProperties": { "type": "string" },
      "properties": {
        "vendor": { "type": "string" },
        "product": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" },
        "category": { "type": "string" },
        "maturity": { "type": "string" },
        "version": {
          "type": "string",
          "pattern": "^(0|[1-9]\\d*)\\.(0|[1-9]\\d*)\\.(0|[1-9]\\d*)$"
        },
        "last-verified": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
        "authors": { "type": "string", "description": "Comma-separated GitHub handles credited in the catalog." },
        "upstream-source": { "type": "string" },
        "upstream-license": { "type": "string" },
        "derived-from": { "type": "string" }
      }
    }
  }
}
