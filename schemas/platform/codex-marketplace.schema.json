{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "platform/codex-marketplace.schema.json",
  "title": "OpenAI Codex marketplace (.agents/plugins/marketplace.json) as generated by this repository",
  "description": "Maintained here. Derived from https://developers.openai.com/plugins/build/plugins (verified 2026-10-14). End-to-end install in Codex has not been verified by this repository yet; see docs/platform-compatibility.md.",
  "type": "object",
  "required": ["name", "interface", "plugins"],
  "additionalProperties": false,
  "properties": {
    "name": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" },
    "interface": {
      "type": "object",
      "required": ["displayName"],
      "additionalProperties": false,
      "properties": { "displayName": { "type": "string" } }
    },
    "plugins": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["name", "source", "policy", "category"],
        "additionalProperties": false,
        "properties": {
          "name": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" },
          "source": {
            "type": "object",
            "required": ["source", "path"],
            "additionalProperties": false,
            "properties": {
              "source": { "const": "local" },
              "path": { "type": "string", "pattern": "^\\./plugins/[a-z0-9-]+$" }
            }
          },
          "policy": {
            "type": "object",
            "required": ["installation", "authentication"],
            "additionalProperties": false,
            "properties": {
              "installation": { "enum": ["AVAILABLE", "INSTALLED_BY_DEFAULT", "NOT_AVAILABLE"] },
              "authentication": { "type": "string" }
            }
          },
          "category": { "type": "string" }
        }
      }
    }
  }
}
