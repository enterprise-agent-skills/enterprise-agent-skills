{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "platform/claude-plugin.schema.json",
  "title": "Claude plugin manifest (.claude-plugin/plugin.json) as generated by this repository",
  "description": "Maintained here. Derived from https://claude.com/docs/plugins/build and https://code.claude.com/docs/en/plugins/manifest-reference (verified 2026-10-14). Covers only the fields this repository emits; run `claude plugin validate` for the authoritative check.",
  "type": "object",
  "required": ["name", "version", "description", "author", "license"],
  "additionalProperties": false,
  "properties": {
    "name": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$", "maxLength": 64 },
    "displayName": { "type": "string" },
    "version": { "type": "string" },
    "description": { "type": "string", "maxLength": 1024 },
    "author": {
      "type": "object",
      "required": ["name"],
      "additionalProperties": false,
      "properties": { "name": { "type": "string" }, "url": { "type": "string" }, "email": { "type": "string" } }
    },
    "homepage": { "type": "string" },
    "repository": { "type": "string" },
    "license": { "type": "string" },
    "keywords": { "type": "array", "items": { "type": "string" } }
  }
}
