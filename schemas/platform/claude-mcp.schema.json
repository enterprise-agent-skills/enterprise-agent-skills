{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "platform/claude-mcp.schema.json",
  "title": "Claude Code plugin MCP configuration (.mcp.json) as generated by this repository",
  "description": "Maintained here. Derived from https://code.claude.com/docs/en/plugins-reference (mcpServers, environment variables, user configuration; checked 2026-10-22). Covers only the shapes this repository emits: a stdio server (command, args, optional env whose values may reference ${CLAUDE_PLUGIN_ROOT} and ${user_config.KEY}) and a remote server (type http, url). Run `claude plugin validate` for the authoritative check.",
  "type": "object",
  "required": ["mcpServers"],
  "additionalProperties": false,
  "properties": {
    "mcpServers": {
      "type": "object",
      "propertyNames": { "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" },
      "additionalProperties": {
        "oneOf": [
          {
            "title": "stdio server",
            "type": "object",
            "required": ["command", "args"],
            "additionalProperties": false,
            "properties": {
              "type": { "const": "stdio" },
              "command": { "type": "string", "minLength": 1 },
              "args": { "type": "array", "items": { "type": "string" } },
              "env": {
                "type": "object",
                "propertyNames": { "pattern": "^[A-Z][A-Z0-9_]*$" },
                "additionalProperties": { "type": "string" }
              }
            }
          },
          {
            "title": "remote server",
            "type": "object",
            "required": ["type", "url"],
            "additionalProperties": false,
            "properties": {
              "type": { "const": "http" },
              "url": { "type": "string", "pattern": "^https://" }
            }
          }
        ]
      }
    }
  }
}
