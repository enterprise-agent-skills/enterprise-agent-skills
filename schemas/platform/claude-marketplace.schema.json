{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "platform/claude-marketplace.schema.json",
  "title": "Claude marketplace (.claude-plugin/marketplace.json) as generated by this repository",
  "description": "Maintained here. Derived from https://code.claude.com/docs/en/plugins/create-marketplace and the GitHub Copilot CLI plugin reference, which also reads this file (verified 2026-10-14). The npx skills installer reads metadata.pluginRoot and plugins[].skills from this file.",
  "type": "object",
  "required": ["name", "owner", "metadata", "plugins"],
  "additionalProperties": false,
  "properties": {
    "name": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$", "maxLength": 64 },
    "owner": {
      "type": "object",
      "required": ["name"],
      "additionalProperties": false,
      "properties": { "name": { "type": "string" }, "url": { "type": "string" }, "email": { "type": "string" } }
    },
    "metadata": {
      "type": "object",
      "required": ["description", "version", "pluginRoot"],
      "additionalProperties": false,
      "properties": {
        "description": { "type": "string" },
        "version": { "type": "string" },
        "pluginRoot": { "type": "string", "pattern": "^\\./" }
      }
    },
    "plugins": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["name", "source", "description", "version"],
        "additionalProperties": false,
        "properties": {
          "name": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" },
          "source": { "type": "string", "pattern": "^\\./plugins/[a-z0-9-]+$" },
          "description": { "type": "string" },
          "version": { "type": "string" },
          "author": { "type": "object" },
          "homepage": { "type": "string" },
          "repository": { "type": "string" },
          "license": { "type": "string" },
          "keywords": { "type": "array", "items": { "type": "string" } },
          "category": { "type": "string" },
          "skills": { "type": "array", "items": { "type": "string" } }
        }
      }
    }
  }
}
