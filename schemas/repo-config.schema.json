{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "repo-config.schema.json",
  "title": "Repository configuration (repo.config.yaml)",
  "type": "object",
  "required": ["repository", "tooling", "vendors", "categories", "maturity_levels", "platforms"],
  "additionalProperties": false,
  "properties": {
    "repository": {
      "type": "object",
      "required": ["name", "owner", "default_branch", "license", "marketplace_name", "marketplace_display_name", "description"],
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" },
        "owner": { "type": "string", "minLength": 1 },
        "default_branch": { "type": "string", "minLength": 1 },
        "license": { "type": "string", "minLength": 1 },
        "marketplace_name": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$", "maxLength": 64 },
        "marketplace_display_name": { "type": "string", "minLength": 1 },
        "description": { "type": "string", "minLength": 20, "maxLength": 1024 },
        "maintainers_contact": { "type": "string" }
      }
    },
    "tooling": {
      "type": "object",
      "required": ["vally_cli_version", "node_version"],
      "additionalProperties": false,
      "properties": {
        "vally_cli_version": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$" },
        "node_version": { "type": "string" }
      }
    },
    "vendors": { "$ref": "#/$defs/idNameList" },
    "categories": { "$ref": "#/$defs/idNameList" },
    "maturity_levels": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "description"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" },
          "description": { "type": "string" }
        }
      }
    },
    "platforms": { "$ref": "#/$defs/idNameList" }
  },
  "$defs": {
    "idNameList": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "name"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" },
          "name": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}
