# Copy to .env next to compose.yaml. Keep the file private: it holds the SAP password.

# The DNS name that points at this host, and the email Let's Encrypt may contact.
PUBLIC_HOST=sap-mcp.example.com
ACME_EMAIL=you@example.com

# The canonical URL of the MCP endpoint: https://<PUBLIC_HOST>/mcp
MCP_PUBLIC_URL=https://sap-mcp.example.com/mcp

# The SAP system, as seen from this host. Use the ICM's HTTPS port: a trial system in Docker on
# the same machine (network_mode host) is https://127.0.0.1:50001 with SAP_INSECURE=true for its
# self-signed certificate; a real system is https://<sap-host>:44300 without SAP_INSECURE.
# The trial's plain HTTP port 50000 can be unavailable (the ICM fails to bind it after some
# restarts), so do not depend on it.
SAP_URL=https://127.0.0.1:50001
SAP_INSECURE=true
SAP_USER=
SAP_PASSWORD=
SAP_CLIENT=001
SAP_LANGUAGE=EN

# Sign-in with Microsoft Entra ID (recommended): the app registration that secures this server.
# docs/copilot-cowork.md explains where each value comes from.
ENTRA_TENANT_ID=
ENTRA_CLIENT_ID=
# Extra audiences, comma-separated: the Application ID URIs of the app registration, for
# example https://sap-mcp.example.com and the URI the Teams developer portal generated.
ENTRA_AUDIENCES=
ENTRA_SCOPE=SAP.Read
# Client applications that may call the server. For Microsoft 365 Copilot Cowork and Copilot
# this is the Microsoft Enterprise token store.
ENTRA_ALLOWED_CLIENT_IDS=ab3be6b7-f5df-413d-ac2d-abf1e3fd9c0b

# Demo mode instead of sign-in, for trial systems with demo data only: leave every ENTRA_
# value empty and set a secret of at least 32 characters (python sap_system_mcp.py new-secret).
# The MCP endpoint is then https://<PUBLIC_HOST>/mcp/<secret>; treat that URL like a password.
# MCP_DEMO_PATH_SECRET=
